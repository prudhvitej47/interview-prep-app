[Unit]
Description=Interview prep application stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/interview-prep
# backup.env carries the VM's AWS key, which the ECR credential helper uses to turn into a
# registry token. app.env carries the image reference and the database password.
EnvironmentFile=/etc/interview-prep/backup.env
EnvironmentFile=/etc/interview-prep/app.env
# Optional (the leading -): the content-repo token for "Send to the curriculum". A file of its own,
# so vm-setup.sh, which rewrites app.env, never drops it.
EnvironmentFile=-/etc/interview-prep/github.env
ExecStart=/usr/bin/docker compose --project-name interview-prep --file /opt/interview-prep/src/deploy/docker-compose.yml up --detach postgres app
# The code runner after them, and optional (the leading -): if it cannot start, code runs are off but
# the stack still counts as started, so the app stays up and vm-setup.sh carries on. Stop covers all three.
ExecStartPost=-/usr/bin/docker compose --project-name interview-prep --file /opt/interview-prep/src/deploy/docker-compose.yml up --detach runner
ExecStop=/usr/bin/docker compose --project-name interview-prep --file /opt/interview-prep/src/deploy/docker-compose.yml stop
# No `down`, and never `down -v`: the database lives on the mounted disk and must not be at the
# mercy of a stop command.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
